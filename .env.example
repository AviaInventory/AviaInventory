# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables. Never commit real values.

# --- Supabase (Project Settings -> API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://uhxxrdobogskvpysmpvj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by the admin console and billing webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Public base URL, used for payment redirects. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.aviainventory.com

# --- Platform console (/platform-console/login) --------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# --- Billing: Paystack (cards + M-Pesa) -----------------------------------------
# Dashboard -> Settings -> API Keys & Webhooks. Use sk_test_/pk_test_ until go-live.
# Webhook URL to set there: https://www.aviainventory.com/api/billing/webhook
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Interim USD -> KES rate for checkout amounts (rounded up to KES 50).
BILLING_USD_KES_RATE=130

# --- WhatsApp Cloud API (Meta) ------------------------------------------------------
# developers.facebook.com -> AviaInventory app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token (business.facebook.com -> Settings -> System users)
WHATSAPP_ACCESS_TOKEN=
# App settings -> Basic -> App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any long random string; the same value goes in Meta's webhook "Verify token" box
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional
BILLING_GRACE_PERIOD_DAYS=7
FEATURED_LISTING_LIMIT=5
